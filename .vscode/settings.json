{
  "go.buildTags": "googlesql,googlesql_unified_prebuilt",
  "go.toolsEnvVars": {
    "CGO_ENABLED": "1",
    "CC": "clang",
    "CXX": "clang++",
    "GOMAXPROCS": "2",
    "GOFLAGS": "-p=1 -tags=googlesql,googlesql_unified_prebuilt",
    "GOCACHE": "${env:HOME}/.cache/go-googlesql/gocache",
    "GOMODCACHE": "${env:HOME}/.cache/go-googlesql/gomodcache",
    "CGO_LDFLAGS_ALLOW": "-Wl,--no-gc-sections|-Wl,--allow-multiple-definition|-fuse-ld=mold|-Wl,--whole-archive|-Wl,--no-whole-archive|-Wl,--start-group|-Wl,--end-group|-stdlib=libc\\+\\+"
  }
}
