# Example pkg-config file for a future consolidated install prefix (prebuilt headers + libs).
# Not wired into generated #cgo blocks today; use when/if a single libzetasql-style layout exists.
#
# Typical usage after installing files under /opt/go-zetasql-cgo:
#   export PKG_CONFIG_PATH=/opt/go-zetasql-cgo/lib/pkgconfig
#   CGO_CFLAGS="$(pkg-config --cflags zetasql)" CGO_LDFLAGS="$(pkg-config --libs zetasql)" go build ...
#
# prefix=/opt/go-zetasql-cgo
# exec_prefix=${prefix}
# libdir=${exec_prefix}/lib
# includedir=${prefix}/include
#
# Name: zetasql
# Description: go-zetasql prebuilt C++ stack (placeholder)
# Version: 0.0.0
# Libs: -L${libdir} -lstdc++ -ldl -lz
# Cflags: -I${includedir} -std=c++17
