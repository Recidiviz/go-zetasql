# pkg-config template for a consolidated go-googlesql prebuilt install prefix.
# Copy to e.g. $GOOGLESQL_PREBUILT_PREFIX/lib/pkgconfig/googlesql.pc and substitute @PREFIX@,
# or use sed/configure to set prefix at install time.
#
# Default protobuf prebuilts today use fixed paths under internal/ccall/go-protobuf/protobuf/lib/
# (see docs/prebuilt-cgo.md). This file describes the *future* multi-lib layout.
# For libgooglesql.a alone (bootstrap), see googlesql-unified.pc.example and docs/libgooglesql-unified.md.
#
# Example (after installing under /opt/go-googlesql-cgo):
#   export GOOGLESQL_PREBUILT_PREFIX=/opt/go-googlesql-cgo
#   export PKG_CONFIG_PATH=$GOOGLESQL_PREBUILT_PREFIX/lib/pkgconfig
#   export CGO_CFLAGS="$(pkg-config --cflags googlesql)"
#   export CGO_LDFLAGS="$(pkg-config --libs googlesql)"
#   go build -tags googlesql,googlesql_tier_b ./...
#
prefix=@PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${exec_prefix}/include

Name: googlesql
Description: go-googlesql prebuilt C++ stack (consolidated headers + static libs; template)
Version: 0.0.0
Requires:
# Static link order: if you ship both archives, list `-labsl_cgo` before or after `-lprotobuf_cgo` per link errors;
# `libprotobuf_cgo.a` may already embed Abseil objects (see docs/prebuilt-absl-overlap.md).
Libs: -L${libdir} -labsl_cgo -lprotobuf_cgo -lz -lstdc++ -ldl -lpthread
Cflags: -I${includedir} -std=c++20

# Platform notes:
# - macOS: swap -lstdc++ for -lc++ in Libs if you only ship libc++-linked archives.
# - Add -fuse-ld=mold via CGO_LDFLAGS / Makefile when mold is available (Linux).
