{{- $fqdn := .FQDN }}
#ifndef {{ .FQDN }}_bind_cc
#define {{ .FQDN }}_bind_cc

// switch namespace
{{- range .ReplaceNameEntries }}
{{- if .CustomReplacement }}
{{- if .Comment }}
// {{ .Comment }}
{{- end }}
#define {{ .Name }} {{ .CustomReplacement }}
{{- else }}
#define {{ .Name }} {{ $fqdn }}_{{ .Name }}
{{- end }}
{{- end }}

#define GO_EXPORT(def) export_{{ $fqdn }}_ ## def
#define U_ICU_ENTRY_POINT_RENAME(x) GO_EXPORT(x)

// bridge_cc.inc uses GoSlice; bridge.inc includes _cgo_export.h again for exported symbols.
#include "_cgo_export.h"

{{ .PreludeBeforeHeaders }}// include headers
//#define private public
{{- range .Headers }}
#include "{{ . }}"
{{- end }}
//#undef private

// include sources
{{- range .Sources }}

{{- .BeforeIncludeHook }}
#include "{{ .Value }}"
{{- .AfterIncludeHook }}

{{- end }}

// include dependencies
{{- range .Deps }}
#include "{{ . }}/export.inc"
{{- end }}

#include "bridge.h"

#include "bridge_cc.inc"

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

#include "bridge.inc"

#ifdef __cplusplus
}
#endif /* __cplusplus */

#endif /* {{ .FQDN }}_bind_cc */
