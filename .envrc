# go-googlesql — CGO/cache env for direnv and Task (same as `task test:local` / `task build:local`).
# Implementation: `scripts/go-googlesql-env.sh`
#
# Usage (once per clone): `direnv allow`
# Without direnv: `source .envrc` before `go test` / `go build`, or run commands via `task`.

# shellcheck shell=bash
_ENVRC_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_ENVRC_DIR/scripts/go-googlesql-env.sh"
go_googlesql_env_export

export CGO_ENABLED=1
# Bare `go build` / `go test` in this directory (tasks set CGO_CXXFLAGS explicitly from *_PREBUILT).
export CGO_CXXFLAGS="${CGO_CXXFLAGS:-$CGO_CXXFLAGS_PREBUILT}"

# Per-machine overrides (optional; see .gitignore)
if [[ -f "$_ENVRC_DIR/.envrc.local" ]]; then
	# shellcheck disable=SC1091
	source "$_ENVRC_DIR/.envrc.local"
fi
