# go-googlesql — CGO env aligned with the default prebuilt protobuf path (`make local/build` /
# `make local/test`).
# Usage: `direnv allow` in this directory.
#
# Still pass build tags explicitly when you need non-default modes, e.g.:
#   go test -tags googlesql,googlesql_unified_prebuilt ./...
# Or uncomment GOFLAGS below (applies to every go command in this tree).
#
export CGO_ENABLED=1
export CC="${CC:-clang}"
export CXX="${CXX:-clang++}"

# Same cache layout as Makefile GO_CACHE_ROOT
export GO_CACHE_ROOT="${GO_CACHE_ROOT:-$HOME/.cache/go-googlesql}"
export GOCACHE="${GOCACHE:-$GO_CACHE_ROOT/gocache}"
export GOMODCACHE="${GOMODCACHE:-$GO_CACHE_ROOT/gomodcache}"
export CCACHE_DIR="${CCACHE_DIR:-$GO_CACHE_ROOT/ccache}"
export CCACHE_COMPRESS="${CCACHE_COMPRESS:-1}"

# Same as Makefile CGO_CXXFLAGS_PREBUILT — required for the default libprotobuf_cgo.a path.
export CGO_CXXFLAGS="${CGO_CXXFLAGS:--stdlib=libc++}"

# Go toolchain allowlist for CGO (see docs/prebuilt-cgo.md).
export CGO_LDFLAGS_ALLOW='-Wl,--no-gc-sections|-Wl,--allow-multiple-definition|-fuse-ld=mold'

if command -v mold >/dev/null 2>&1; then
  export CGO_LDFLAGS='-Wl,--no-gc-sections -Wl,--allow-multiple-definition -fuse-ld=mold'
else
  export CGO_LDFLAGS='-Wl,--no-gc-sections -Wl,--allow-multiple-definition'
fi

# Uncomment to default the main `googlesql` tag for bare `go test` / `go build`:
# export GOFLAGS='-tags=googlesql'

# Per-machine overrides (see .gitignore)
if [[ -f .envrc.local ]]; then
	source_env .envrc.local
fi
